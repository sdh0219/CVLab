---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchDetailView from '../../components/views/ResearchDetailView.astro';
import { getLocaleEntries } from '../../lib/content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const areas = await getLocaleEntries('researchAreas', 'zh');
  return areas.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout locale="zh" title={entry.data.title} compact altPath={`/en/research/${entry.slug}/`}>
  <ResearchDetailView locale="zh" entry={entry}><Content /></ResearchDetailView>
</BaseLayout>
