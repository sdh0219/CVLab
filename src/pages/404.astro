---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, ui } from '../i18n/ui';
import { localePath } from '../lib/content';
---

<BaseLayout locale="zh" title={ui.zh['notfound.title']} compact>
  <section class="rail nf">
    <p class="nf__code">404</p>
    <h2 class="nf__title">{t('zh', 'notfound.title')}</h2>
    <p><a class="nf__back" href={localePath('zh', '/')}>{t('zh', 'notfound.back')} →</a></p>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: var(--space-3xl);
    text-align: center;
  }
  .nf__code {
    font-family: var(--font-mono);
    color: var(--color-accent-ink);
    font-size: var(--text-xl);
    margin: 0;
  }
  .nf__title {
    font-size: var(--text-2xl);
    margin: var(--space-2xs) 0 var(--space-md);
  }
  .nf__back {
    text-decoration: none;
    border-bottom: var(--rule-hair) solid currentColor;
    color: var(--color-accent-ink);
  }
</style>
