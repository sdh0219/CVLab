---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LearnDetailView from '../../../components/views/LearnDetailView.astro';
import { getLocaleEntries } from '../../../lib/content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const items = (await getLocaleEntries('resources', 'en')).filter((e) => !e.data.externalUrl);
  return items.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout locale="en" title={entry.data.titleEn} compact altPath={`/learn/${entry.slug}/`}>
  <LearnDetailView locale="en" entry={entry}>
    <Content />
  </LearnDetailView>
</BaseLayout>
