---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectDetailView from '../../../components/views/ProjectDetailView.astro';
import { getLocaleEntries } from '../../../lib/content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getLocaleEntries('projects', 'en');
  return projects.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout locale="en" title={entry.data.titleEn} compact altPath={`/projects/${entry.slug}/`}>
  <ProjectDetailView locale="en" entry={entry}><Content /></ProjectDetailView>
</BaseLayout>
