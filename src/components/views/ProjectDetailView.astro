---
import { t, type Locale } from '../../i18n/ui';
import { getLocaleEntries, localePath, type LocaleEntry } from '../../lib/content';

interface Props {
  locale: Locale;
  entry: LocaleEntry<'projects'>;
}
const { locale, entry } = Astro.props;
const d = entry.data;

const datasets = (await getLocaleEntries('datasets', locale)).filter((x) => d.datasetRefs.includes(x.slug));
const areas = (await getLocaleEntries('researchAreas', locale)).filter((x) => d.areaRefs.includes(x.slug));
const heading = locale === 'zh' ? d.title : d.titleEn;
---

<section class="rail">
  <nav class="crumbs" aria-label={locale === 'zh' ? '面包屑' : 'Breadcrumb'}>
    <a href={localePath(locale, '/projects/')}>{t(locale, 'nav.projects')}</a>
    <span aria-hidden="true"> / </span>
    <span>{heading}</span>
  </nav>

  <header class="head">
    <h2 class="head__title">
      {heading}
      {d.placeholder && <span class="badge-tbd">{t(locale, 'common.example')}</span>}
    </h2>
    <dl class="head__facts">
      <div>
        <dt>{t(locale, 'projects.source')}</dt>
        <dd>{locale === 'zh' ? d.source : d.sourceEn}</dd>
      </div>
      <div>
        <dt>{t(locale, 'projects.period')}</dt>
        <dd>{d.period}</dd>
      </div>
      <div>
        <dt>{locale === 'zh' ? '状态' : 'Status'}</dt>
        <dd>{t(locale, d.status === 'ongoing' ? 'common.status.ongoing' : 'common.status.completed')}</dd>
      </div>
      {d.repoUrl && (
        <div>
          <dt>{locale === 'zh' ? '代码仓库' : 'Code'}</dt>
          <dd>
            <a href={d.repoUrl} rel="noopener">{d.repoUrl.replace(/^https?:\/\//, '')}</a>
          </dd>
        </div>
      )}
    </dl>
    {d.tags.length > 0 && (
      <p class="head__tags">{d.tags.map((tag) => <span class="chip">{tag}</span>)}</p>
    )}
  </header>

  <div class="prose">
    <slot />
  </div>

  {!d.hasRepro && !d.placeholder && (
    <p class="norepro"><span class="badge-tbd">{t(locale, 'common.tbd')}</span> {t(locale, 'projects.noRepro')}</p>
  )}

  {areas.length > 0 && (
    <p class="related-areas">
      {locale === 'zh' ? '所属方向' : 'Areas'}：
      {areas.map((a, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          <a href={localePath(locale, `/research/${a.slug}/`)}>{locale === 'zh' ? a.data.title : a.data.titleEn}</a>
        </>
      ))}
    </p>
  )}

  {datasets.length > 0 && (
    <section class="related">
      <h3>{t(locale, 'projects.relatedDatasets')}</h3>
      <ul>
        {datasets.map((x) => (
          <li>
            <a href={localePath(locale, `/datasets/#${x.slug}`)}>{locale === 'zh' ? x.data.name : x.data.nameEn}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</section>

<style>
  .crumbs {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-bottom: var(--space-sm);
  }
  .crumbs a {
    text-decoration: none;
  }
  .head {
    border-bottom: var(--rule-med) solid var(--color-ink);
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  .head__title {
    font-size: var(--text-2xl);
    line-height: 1.35;
    margin: 0 0 var(--space-sm);
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .badge-tbd {
    vertical-align: 0.2em;
    margin-inline-start: var(--space-2xs);
  }
  .head__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: var(--space-sm) var(--space-lg);
    margin: 0;
  }
  .head__facts dt {
    font-size: var(--text-xs);
    color: var(--color-muted);
    letter-spacing: 0.06em;
  }
  .head__facts dd {
    margin: 0;
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .head__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: var(--space-sm) 0 0;
  }
  .prose {
    max-width: none;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    max-width: var(--measure);
  }
  .prose :global(h2) {
    font-size: var(--text-lg);
    margin-top: var(--space-xl);
    padding-top: var(--space-2xs);
    border-top: var(--rule-hair) solid var(--color-rule);
  }
  .norepro {
    margin-top: var(--space-lg);
    color: var(--color-muted);
    font-size: var(--text-sm);
    max-width: var(--measure);
  }
  .related-areas {
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
  }
  .related {
    margin-top: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-rule);
    padding-top: var(--space-md);
  }
  .related h3 {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-sm);
  }
  .related ul {
    margin: 0;
    padding-left: 1.1em;
    font-size: var(--text-sm);
  }
</style>
